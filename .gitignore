# Credentials, never commit
dashboard.txt
.env
.env.*
!.env.example
!.env.test

# Local scratch files and folders at the repo root (helper scripts, throwaway
# mockups, captured logs). Anchored so api/_lib and friends stay tracked.
/_*

# Playwright MCP captures (snapshots/screenshots)
.playwright-mcp/

# Personal bug/feature notes
reports/

# Local planning / audit notes (not part of the app).
# Ignore contents by default, but track files that follow a clear
# convention so future sessions can find them:
#   - TEMPLATE.md   plan structure
#   - *-design.md   approved design specs (output of brainstorming)
#   - *-spec.md     any other shareable spec
#   - *-plan.md     approved implementation plans (output of writing-plans)
# Personal audit notes that don't match these patterns stay local.
plans_md/*
!plans_md/TEMPLATE.md
!plans_md/*-design.md
!plans_md/*-spec.md
!plans_md/*-plan.md

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript incremental build cache (regenerated on every build)
*.tsbuildinfo

# Playwright
playwright-report/
test-results/

.vercel

# Stray TS emit (Vercel builds functions from source)
api/**/*.js
src/**/*.js
